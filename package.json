{
  "name": "dsh-gateway-compaction",
  "version": "2.0.0",
  "description": "Provider-neutral DSH compaction: bounded chunked summaries, per-model budgets, native settings and safe durable transactions.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "qwen",
    "qwen3.8",
    "llama.cpp",
    "ninfer",
    "unsloth",
    "compaction",
    "reasoning-effort",
    "enable_thinking"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IamWWT/dsh-gateway-compaction.git"
  },
  "homepage": "https://github.com/IamWWT/dsh-gateway-compaction#readme",
  "bugs": "https://github.com/IamWWT/dsh-gateway-compaction/issues",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "native-compaction.js",
    "transactions.js",
    "config.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.4 <4",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs && node test/native-compaction.mjs && node test/auto-rescue.mjs",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "jsdom": "29.1.1"
  }
}
