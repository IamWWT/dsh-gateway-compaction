{
  "name": "dsh-gateway-compaction",
  "version": "1.3.1",
  "description": "DSH plugin (local Qwen3.8 gateways: llama.cpp/Unsloth Studio AND NInfer): thinking off for compaction-only calls via engine-appropriate wire fields (llama.cpp: chat_template_kwargs.enable_thinking; NInfer: reasoning_effort), non-thinking sampling parameters and a max_tokens floor; plus a chunked map-reduce rescue when the conversation is larger than the target model's context window (the 1M->250k model-switch 'cannot compact' case)",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "qwen",
    "qwen3.8",
    "llama.cpp",
    "ninfer",
    "unsloth",
    "compaction",
    "reasoning-effort",
    "enable_thinking"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IamWWT/dsh-gateway-compaction.git"
  },
  "homepage": "https://github.com/IamWWT/dsh-gateway-compaction#readme",
  "bugs": "https://github.com/IamWWT/dsh-gateway-compaction/issues",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0 <4.0.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.1-rc.1 <0.1.2 || >=0.1.2-0 <0.2.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  }
}
